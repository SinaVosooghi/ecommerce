# Server Configuration
APP_PORT=8080
ENV_NAME=dev
SERVICE_NAME=cart-service

# Logging
LOG_LEVEL=info

# AWS Configuration
AWS_REGION=us-east-1
AWS_XRAY_ENABLED=false

# DynamoDB Configuration
DYNAMODB_TABLE=cart-service-carts
DYNAMODB_ENDPOINT=http://localhost:8000

# Rate Limiting
RATE_LIMIT_RPS=100
RATE_LIMIT_BURST=200

# Request Limits
MAX_REQUEST_SIZE=1048576

# Idempotency (records are stored in the DynamoDB table above)
IDEMPOTENCY_ENABLED=true
IDEMPOTENCY_TTL=24h

# Circuit Breaker
CIRCUIT_BREAKER_ENABLED=true
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_SUCCESS_THRESHOLD=3
CIRCUIT_BREAKER_TIMEOUT=30s

# Retry Configuration
RETRY_MAX_ATTEMPTS=3
RETRY_INITIAL_DELAY=100ms
RETRY_MAX_DELAY=5s

# Timeouts
DYNAMODB_READ_TIMEOUT=500ms
DYNAMODB_WRITE_TIMEOUT=1s

# EventBridge Configuration
EVENTBRIDGE_ENABLED=true
EVENTBRIDGE_BUS_NAME=default
EVENTBRIDGE_SOURCE=cart-service

# Feature Flags
FEATURE_FLAGS_ENABLED=false

# Metrics (CloudWatch Embedded Metric Format on stdout)
METRICS_ENABLED=false

# Authentication
# AUTH_ENABLED=false is only accepted when ENV_NAME=dev.
AUTH_ENABLED=true
# HS256 signing key, at least 32 bytes (e.g. `openssl rand -base64 48`).
# In AWS, ECS injects it from Secrets Manager.
JWT_SECRET_KEY=

# CORS: comma-separated origins. "*" is only accepted in dev; empty disables CORS.
CORS_ALLOWED_ORIGINS=*
CORS_ALLOWED_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=Accept,Authorization,Content-Type,X-Request-ID,Idempotency-Key

# JWT Configuration
JWT_ISSUER=
JWT_AUDIENCE=
